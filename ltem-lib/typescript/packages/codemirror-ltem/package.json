{
  "name": "codemirror-ltem",
  "version": "0.2.11",
  "description": "LTEM tables in CodeMirror 6: recognition, highlighting, validation with fixes, table editing, ranges of cells, a table menu, HTML and TSV paste and copy, tables shown and edited as tables",
  "license": "MIT",
  "author": "EurekaAI Co., Ltd.",
  "homepage": "https://hugman.github.io/ltem/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugman/ltem.git",
    "directory": "ltem-lib/typescript/packages/codemirror-ltem"
  },
  "bugs": {
    "url": "https://github.com/hugman/ltem/issues"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "markdown",
    "table",
    "colspan",
    "rowspan",
    "ltem"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "bundle:test": "esbuild test-browser/page.ts --bundle --format=iife --outfile=test-browser/dist/page.js --log-level=warning && node -e \"for (const f of ['page.html','page-shadow.html','page.css']) require('fs').copyFileSync('test-browser/'+f,'test-browser/dist/'+f)\"",
    "test:browser": "npm run bundle:test && node --test \"test-browser/**/*.test.ts\"",
    "bench": "node bench/keystroke.ts && node bench/baseline.ts && npm run bundle:test && node test-browser/perf.ts"
  },
  "dependencies": {
    "ltem-core": "0.1.1"
  },
  "peerDependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.30.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.3.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.8.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.2",
    "markdown-it-ltem": "0.1.0",
    "playwright": "^1.64.1"
  }
}

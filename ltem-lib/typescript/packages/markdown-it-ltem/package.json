{
  "name": "markdown-it-ltem",
  "version": "0.1.0",
  "description": "markdown-it plugin for LTEM tables: merged cells (colspan, rowspan) and multi-row headers",
  "license": "MIT",
  "keywords": [
    "markdown-it-plugin",
    "markdown-it",
    "markdown",
    "table",
    "colspan",
    "rowspan",
    "ltem"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "ltem-core": "0.1.0"
  },
  "peerDependencies": {
    "markdown-it": "^14 || ^15"
  },
  "devDependencies": {
    "markdown-it": "^15.0.2",
    "markdown-it-14": "npm:markdown-it@^14.3.2"
  }
}

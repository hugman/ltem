{
  "name": "micromark-extension-ltem",
  "version": "0.1.0",
  "description": "micromark extension for LTEM tables: merged cells (colspan, rowspan) and multi-row headers",
  "license": "MIT",
  "author": "EurekaAI Co., Ltd.",
  "homepage": "https://hugman.github.io/ltem/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hugman/ltem.git",
    "directory": "ltem-lib/typescript/packages/micromark-extension-ltem"
  },
  "bugs": {
    "url": "https://github.com/hugman/ltem/issues"
  },
  "keywords": [
    "micromark",
    "micromark-extension",
    "markdown",
    "unified",
    "table",
    "colspan",
    "rowspan",
    "ltem"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "ltem-core": "0.1.1",
    "micromark-util-types": "^2.0.0"
  },
  "devDependencies": {
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0"
  }
}

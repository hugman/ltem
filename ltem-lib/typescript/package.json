{
  "name": "ltem-typescript",
  "private": true,
  "description": "TypeScript workspace for LTEM: the core library and Markdown parser plugins",
  "type": "module",
  "workspaces": [
    "packages/ltem",
    "packages/markdown-it-ltem",
    "packages/marked-ltem",
    "packages/micromark-extension-ltem",
    "packages/mdast-util-ltem",
    "packages/remark-ltem",
    "packages/codemirror-ltem",
    "packages/codemirror-ltem-live"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run build && npm test --workspaces",
    "clean": "npm run clean --workspaces",
    "pack": "npm run build && npm pack --workspaces --pack-destination dist-pack"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
